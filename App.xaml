<Application x:Class="ForzavistaFreeRoam.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- ===== Palette (Forza Mods dark/pink — deepened for elevation, same hues) ===== -->
    <SolidColorBrush x:Key="WinBg"    Color="#FF1D1D1F"/>
    <SolidColorBrush x:Key="Card"     Color="#FF2C2C2F"/>
    <SolidColorBrush x:Key="Card2"    Color="#FF232326"/>
    <SolidColorBrush x:Key="CardHead" Color="#FF333337"/>
    <SolidColorBrush x:Key="TitleBar" Color="#FF161618"/>
    <SolidColorBrush x:Key="Line"     Color="#FF3C3C40"/>
    <SolidColorBrush x:Key="Hairline" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="Ink"      Color="#FFF4F4F6"/>
    <SolidColorBrush x:Key="Dim"      Color="#FF9C9CA2"/>
    <SolidColorBrush x:Key="Faint"    Color="#FF6E6E74"/>
    <SolidColorBrush x:Key="Good"     Color="#FFE8175D"/>
    <SolidColorBrush x:Key="Warn"     Color="#FFFFB347"/>
    <SolidColorBrush x:Key="Pink"     Color="#FFE8175D"/>
    <SolidColorBrush x:Key="Pink2"    Color="#FFCC527A"/>

    <!-- ===== Display font (bundled) ===== -->
    <FontFamily x:Key="DisplayFont">pack://application:,,,/assets/Fonts/#Gang of Three</FontFamily>

    <!-- ===== Elevation gradients (subtle top-lit surfaces) ===== -->
    <LinearGradientBrush x:Key="AppGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF212123" Offset="0"/>
      <GradientStop Color="#FF191919" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF303034" Offset="0"/>
      <GradientStop Color="#FF29292C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardHeadGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF3A3A3F" Offset="0"/>
      <GradientStop Color="#FF303034" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TitleBarGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF1B1B1D" Offset="0"/>
      <GradientStop Color="#FF141416" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PinkGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFF2E70" Offset="0"/>
      <GradientStop Color="#FFE8175D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PinkGradHover" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFF4A84" Offset="0"/>
      <GradientStop Color="#FFF02765" Offset="1"/>
    </LinearGradientBrush>

    <!-- Thin pink brand accent (fades to transparent) -->
    <LinearGradientBrush x:Key="PinkAccentLine" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FFE8175D" Offset="0"/>
      <GradientStop Color="#66E8175D" Offset="0.55"/>
      <GradientStop Color="#00E8175D" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== Reusable soft shadow ===== -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="3" Direction="270"
                      Color="#FF000000" Opacity="0.42"/>

    <!-- ===== Card container (elevated) ===== -->
    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardGrad}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>

    <Style x:Key="CardHeadStrip" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardHeadGrad}"/>
      <Setter Property="CornerRadius" Value="12,12,0,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="14,0"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Small pink accent bar for section headers -->
    <Style x:Key="HeadAccent" TargetType="Border">
      <Setter Property="Width" Value="3"/>
      <Setter Property="Height" Value="15"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Background" Value="{StaticResource Pink}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FFE8175D" Opacity="0.7"/>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Faint}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="LineHeight" Value="17"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,8,0,2"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Ghost button (subtle utility) ===== -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="#FF313135"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Pink2}"/>
                <Setter TargetName="b" Property="Background" Value="#FF3B3B40"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FF2A2A2E"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Pink-outlined button ===== -->
    <Style x:Key="PinkButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Foreground" Value="{StaticResource Pink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Pink}"/>
      <Setter Property="Background" Value="#22E8175D"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#44E8175D"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#66C9124E"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Pink filled button (primary action, gradient + glow) ===== -->
    <Style x:Key="PinkFilled" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource PinkGrad}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#FFE8175D" Opacity="0.45"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource PinkGradHover}"/>
                <Setter TargetName="b" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#FFE8175D" Opacity="0.7"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FFC9124E"/>
                <Setter TargetName="b" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#FFE8175D" Opacity="0.3"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Line}"/>
                <Setter TargetName="b" Property="Effect" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{StaticResource Faint}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Custom title bar caption buttons ===== -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FF34343A"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FF2A2A2E"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Pink}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FFC9124E"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Dark ScrollBar ===== -->
    <Style x:Key="ScrollNubHidden" TargetType="RepeatButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="t" Background="#FF4A4A50" CornerRadius="4" Margin="3,2"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="t" Property="Background" Value="#FF64646C"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="t" Property="Background" Value="{StaticResource Pink2}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollNubHidden}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollNubHidden}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Application.Resources>
</Application>
