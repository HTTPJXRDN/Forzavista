<Window x:Class="ForzavistaFreeRoam.LightingCycleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom color cycle" Width="540" Height="600" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WinBg}"
        Foreground="{StaticResource Ink}" FontFamily="Segoe UI" UseLayoutRounding="True">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="LightingDialogStyles.xaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{StaticResource TitleBar}" BorderBrush="{StaticResource Pink}" BorderThickness="0,0,0,2" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid><TextBlock Text="CUSTOM COLOR CYCLE" Foreground="{StaticResource Pink}" FontSize="16" FontWeight="SemiBold"/>
          <Button Content="&#x2715;" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Padding="10,3" IsCancel="True"/></Grid>
      </Border>
      <Grid Grid.Row="1" Margin="20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Choose 2–12 colors in order. Each fades into the next, then loops back to the first." Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
          <Button Content="RED" Tag="#FF0000" Click="QuickColor_Click" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="10,7"/>
          <Button Content="YELLOW" Tag="#FFFF00" Click="QuickColor_Click" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="10,7"/>
          <Button Content="BLUE" Tag="#0000FF" Click="QuickColor_Click" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="10,7"/>
          <Button Content="GREEN" Tag="#00FF00" Click="QuickColor_Click" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="10,7"/>
          <Button Content="PURPLE" Tag="#8000FF" Click="QuickColor_Click" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="10,7"/>
          <Button Content="PINK" Tag="#FF1493" Click="QuickColor_Click" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="10,7"/>
          <Button Content="WHITE" Tag="#FFFFFF" Click="QuickColor_Click" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="10,7"/>
          <Button Content="ORANGE" Tag="#FF8000" Click="QuickColor_Click" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="10,7"/>
        </WrapPanel>
        <ListBox x:Name="ColorList" Grid.Row="2" SelectionChanged="ColorList_SelectionChanged" AutomationProperties.Name="Colors in cycle order">
          <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal">
            <Border Background="{Binding Brush}" Width="30" Height="20" CornerRadius="4" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
          </StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <UniformGrid Grid.Row="3" Columns="5" Margin="0,10,0,0">
          <Button x:Name="AddButton" Content="ADD…" Style="{StaticResource GhostButton}" Click="Add_Click" Height="32" Margin="0,0,5,0"/>
          <Button x:Name="EditButton" Content="EDIT…" Style="{StaticResource GhostButton}" Click="Edit_Click" Margin="0,0,5,0"/>
          <Button x:Name="RemoveButton" Content="REMOVE" Style="{StaticResource GhostButton}" Click="Remove_Click" Margin="0,0,5,0"/>
          <Button x:Name="UpButton" Content="UP" Style="{StaticResource GhostButton}" Click="Up_Click" Margin="0,0,5,0"/>
          <Button x:Name="DownButton" Content="DOWN" Style="{StaticResource GhostButton}" Click="Down_Click"/>
        </UniformGrid>
        <TextBlock x:Name="CycleStatus" Grid.Row="4" TextWrapping="Wrap" Foreground="{StaticResource Dim}" MinHeight="34" Margin="0,10,0,0"/>
      </Grid>
      <Border Grid.Row="2" Background="{StaticResource Card2}" Padding="20,14">
        <Grid><Button Content="CANCEL" IsCancel="True" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Height="34" Width="110"/>
          <Button Content="USE THESE COLORS" Style="{StaticResource PinkFilled}" Click="Accept_Click" HorizontalAlignment="Right" Height="34" Width="180" IsDefault="True"/></Grid>
      </Border>
    </Grid>
  </Border>
</Window>
