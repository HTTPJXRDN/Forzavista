<Window x:Class="ForzavistaFreeRoam.LightingPresetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lighting presets" Width="560" Height="610" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WinBg}"
        Foreground="{StaticResource Ink}" FontFamily="Segoe UI" UseLayoutRounding="True">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="LightingDialogStyles.xaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{StaticResource TitleBar}" BorderBrush="{StaticResource Pink}" BorderThickness="0,0,0,2" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid><TextBlock Text="LIGHTING PRESETS" Foreground="{StaticResource Pink}" FontSize="16" FontWeight="SemiBold"/>
          <Button Content="&#x2715;" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Padding="10,3" IsCancel="True"/></Grid>
      </Border>
      <Grid Grid.Row="1" Margin="20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Save color or cycle, brightness, speed, strobe, and fade settings. Apply a preset to the current car when you want it." Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <ListBox x:Name="PresetList" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="PresetList_SelectionChanged" AutomationProperties.Name="Saved lighting presets"/>
        <TextBlock x:Name="PresetDescription" Grid.Row="2" Foreground="{StaticResource Dim}" TextWrapping="Wrap" MinHeight="60" Margin="0,10,0,10"/>
        <TextBlock Grid.Row="3" Text="SAVE CURRENT SETTINGS AS" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
        <Grid Grid.Row="4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
          <TextBox x:Name="PresetName" MaxLength="64" AutomationProperties.Name="Preset name" ToolTip="Use an existing name to update that preset."/>
          <Button x:Name="SaveButton" Grid.Column="2" Content="SAVE" Style="{StaticResource GhostButton}" Click="Save_Click"/>
        </Grid>
        <TextBlock x:Name="PresetStatus" Grid.Row="5" Foreground="{StaticResource Dim}" TextWrapping="Wrap" MinHeight="40" Margin="0,10,0,0"/>
      </Grid>
      <Border Grid.Row="2" Background="{StaticResource Card2}" Padding="20,14">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
          <Button Content="CLOSE" IsCancel="True" Style="{StaticResource GhostButton}" Height="34"/>
          <Button x:Name="DeleteButton" Grid.Column="2" Content="DELETE" Style="{StaticResource GhostButton}" Click="Delete_Click"/>
          <Button x:Name="ApplyButton" Grid.Column="4" Content="APPLY SELECTED" Style="{StaticResource PinkFilled}" Click="Apply_Click" IsDefault="True"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
